{
  "schemaVersion": 1,
  "id": "croptopiadelight",
  "version": "${version}",

  "name": "Croptopia Delight",
  "description": "Mod adds the integration of Croptopia recipes with Farmer's Delight and their addons.",
  "authors": [
    "Ropyxa, Ray Lirov"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/croptopia-delight"
  },

  "license": "GPL-3.0",
  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
    "client": ["net.raylirov.croptopiadelight.client.CroptopiaDelightClient"],
    "main": ["net.raylirov.croptopiadelight.CroptopiaDelight"]
  },

  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "croptopia": ">=${croptopia_version}",
    "farmersdelight": ">=${farmersdelight_version}"
  }
}
